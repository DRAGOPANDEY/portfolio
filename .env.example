# ---------- Contact form via Resend ----------
# Without these, /api/contact logs submissions and still returns success (good for local dev).
# To actually deliver emails to your inbox:
#   1. Sign up at https://resend.com (free tier covers personal portfolios)
#   2. Create an API key and paste it below
#   3. (Optional) Verify your custom domain and update RESEND_FROM
RESEND_API_KEY=
CONTACT_TO_EMAIL=mohitpy6371@gmail.com
# Until you verify a domain in Resend, use the sandbox sender:
RESEND_FROM=Portfolio <onboarding@resend.dev>
